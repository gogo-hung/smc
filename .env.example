# 複製成 .env 再填

# Telegram（不填就只印在終端機）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 掃描範圍
TOP_N=60                    # 24h 成交額前幾名
MIN_QUOTE_VOLUME=5000000    # 24h 成交額下限（USDT）
WATCHLIST=BTC,ETH,SOL       # 一定要掃的幣
EXCLUDE=                    # 不掃的幣，例：USDC,FDUSD
INCLUDE_TRADFI=false        # true = 也掃美股、指數、黃金原油（BingX 的 NC 開頭商品）

# 財經日曆提醒（ForexFactory 週曆）
CAL_COUNTRIES=USD           # 要推播的國家，例：USD,CNY
CAL_MIN_IMPACT=High         # High / Medium / Low
CAL_ALERT_LEADS=30,5        # 公布前幾分鐘推播

# 美股財報（會自動加上 BingX 有上架的美股）
EARNINGS_TICKERS=NVDA,TSLA,AAPL,MSFT,AMZN,META,GOOGL,COIN,MSTR

# 風控鎖：今天連虧幾筆就鎖住進場提醒（0 = 關閉）
LOCK_AFTER_LOSSES=2

# 永久儲存（Upstash Redis，免費）：沒設的話資料存在伺服器，重新部署會清空
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 伺服器
PORT=8787
ADMIN_TOKEN=                # 部署到公開網址時一定要設，避免別人改你的規則
PUBLIC_URL=                 # 看板網址，填了推播會附連結

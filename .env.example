# 複製成 .env 再填

# Telegram（不填就只印在終端機）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 掃描範圍
TOP_N=60                    # 24h 成交額前幾名
MIN_QUOTE_VOLUME=5000000    # 24h 成交額下限（USDT）
WATCHLIST=BTC,ETH,SOL       # 一定要掃的幣
EXCLUDE=                    # 不掃的幣，例：USDC,FDUSD

# 伺服器
PORT=8787
ADMIN_TOKEN=                # 部署到公開網址時一定要設，避免別人改你的規則
PUBLIC_URL=                 # 看板網址，填了推播會附連結
